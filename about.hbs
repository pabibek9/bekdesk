<!doctype html>
<html><head><meta charset="utf-8"><title>bekdesk third-party licenses</title>
<style>body{font:14px/1.5 system-ui,sans-serif;max-width:900px;margin:40px auto;padding:0 16px}pre{white-space:pre-wrap;background:#f4f4f5;padding:12px;border-radius:8px;font-size:12px}</style></head>
<body><h1>Third-party licenses</h1><p>Rust crates linked into bekdesk.</p>
<ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul>
{{#each licenses}}<h2 id="{{id}}">{{name}}</h2><p>Used by:</p><ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul><pre>{{text}}</pre>{{/each}}
</body></html>
