{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bekdesk",
  "version": "0.1.23",
  "identifier": "io.github.pabibek9.bekdesk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bekdesk",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Use your computers together over the local network",
    "copyright": "bekdesk contributors, GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "flatpak",
          "pulseaudio-utils"
        ]
      },
      "deb": {
        "depends": [
          "pulseaudio-utils"
        ]
      }
    }
  }
}
